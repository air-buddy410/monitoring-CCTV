# Dummy local values only. Never commit real secrets.
NODE_ENV=development
PORT=3000
BASE_URL=http://localhost:3000
# connect as the NON-owner application role (RLS applies)
DATABASE_URL=postgresql://pantau_app:pantau_dev_pw@127.0.0.1:5432/pantau
# schema owner, used only by `pnpm db:migrate`
MIGRATION_DATABASE_URL=postgresql://pantau_owner:pantau_dev_pw@127.0.0.1:5432/pantau
APP_DB_ROLE=pantau_app
# >= 32 chars
AUTH_SECRET=change-me-change-me-change-me-12345
# 32 random bytes, base64:  node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
VAULT_KEY=
# dev/test only: lets the API dial 127.0.0.1 (the local mock). Keep false elsewhere.
ALLOW_LOOPBACK_TARGETS=true
# Explicit device target allow-list (comma-separated CIDRs). Empty = 10/8, 172.16/12, 192.168/16, fc00::/7 only.
# Link-local, metadata, multicast and unspecified addresses are always refused.
TARGET_ALLOW_CIDRS=
# Extra browser origins allowed for state-changing requests (BASE_URL is always allowed)
TRUSTED_ORIGINS=
# true only behind a reverse proxy you control (affects client IP used by rate limiting)
TRUST_PROXY=false
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_PROBE_PER_MIN=10
RATE_LIMIT_SNAPSHOT_PER_MIN=30
RATE_LIMIT_AUTH_PER_MIN=10
ONVIF_TIMEOUT_MS=5000
SNAPSHOT_TIMEOUT_MS=5000
LOG_LEVEL=info
