{
  "name": "@pantau/web",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "next dev -p 3100",
    "build": "NEXT_TELEMETRY_DISABLED=1 PANTAU_API_ORIGIN=${PANTAU_API_ORIGIN:-http://127.0.0.1:3101} next build",
    "start": "next start -p 3100",
    "typecheck": "tsc -p tsconfig.json",
    "test:e2e": "tsx scripts/prepare-db.ts pantau_e2e && playwright test",
    "demo:frames": "node scripts/make-demo-frames.mjs",
    "e2e:db": "tsx scripts/prepare-db.ts",
    "demo": "tsx scripts/demo.ts",
    "demo:screenshots": "tsx scripts/screenshots.ts"
  },
  "dependencies": {
    "@fontsource/atkinson-hyperlegible-mono": "^5.2.0",
    "@fontsource/atkinson-hyperlegible-next": "^5.2.0",
    "@pantau/contracts": "workspace:*",
    "next": "^16.3.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "uqr": "^0.1.3",
    "zod": "^4.1.0"
  },
  "devDependencies": {
    "@pantau/mock-onvif": "workspace:*",
    "@playwright/test": "1.56.1",
    "@tailwindcss/postcss": "^4.1.0",
    "@types/pg": "^8.11.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "pg": "^8.13.0",
    "tailwindcss": "^4.1.0"
  }
